{
  "name": "traceforge",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev --filter=@traceforge/web --filter=@traceforge/worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @traceforge/db db:generate",
    "db:migrate": "pnpm --filter @traceforge/db db:migrate",
    "db:studio": "pnpm --filter @traceforge/db db:studio"
  },
  "devDependencies": {
    "dotenv-cli": "8.0.0",
    "prettier": "3.5.3",
    "turbo": "2.5.0",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=9.15.9 <10"
  },
  "type": "module"
}
