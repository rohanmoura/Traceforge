{
  "name": "@traceforge/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.5.0"
  },
  "devDependencies": {
    "@traceforge/eslint-config": "workspace:*",
    "@traceforge/typescript-config": "workspace:*",
    "@types/node": "22.14.0",
    "eslint": "9.24.0",
    "dotenv-cli": "8.0.0",
    "prisma": "6.5.0",
    "typescript": "5.8.3"
  }
}
